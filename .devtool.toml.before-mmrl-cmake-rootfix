[project]
kind = "android"
default_target = "mmrl_android"

[execution]
environment = "auto"
chroot_name = "androidos"
device_serial = ""

[targets.mmrl_android]
type = "android"
root = "."
execution_environment = "native-termux"
chroot_name = "androidos"

[targets.mmrl_android.android]
variant = "officialDebug"
aapt2_provider = "termux"
instrumentation = "never"
prefer_native_termux = true

[targets.mmrl_android.gradle]
version = "9.7.0"
provider = "auto"
max_workers = 2
structured_events = false
no_daemon = false
daemon_idle_timeout_ms = 900000
parallel = true
build_cache = true
fail_fast = true
offline = false
args = [
  "-Dorg.gradle.parallel=true",
  "-Dorg.gradle.vfs.watch=false",
  "-Pkotlin.incremental=true",
  "-Pkotlin.compiler.execution.strategy=in-process",
  "-Pmmrl.fullLint=true",
]

[targets.mmrl_android.tasks]
restore = ["help"]
build = [
  ":app:assembleOfficialDebug",
  ":app:assembleOfficialRelease",
  ":app:assembleOfficialPlaystore",
]
test = [
  ":platform:testDebugUnitTest",
  ":platform:testNativeContracts",
  ":app:testOfficialDebugUnitTest",
]
lint = [":app:lintOfficialDebug"]
clean = ["clean"]

[targets.mmrl_android.artifacts]
required = true

[validation.phases]
preflight = [
  "help",
]
compile = [
  ":app:compileOfficialDebugSources",
  ":app:compileOfficialDebugAndroidTestKotlin",
]
resources = [
  ":app:processOfficialDebugResources",
]
unit-test = [
  ":platform:testDebugUnitTest",
  ":platform:testNativeContracts",
  ":app:testOfficialDebugUnitTest",
]
package = [
  ":app:assembleOfficialDebug",
  ":app:assembleOfficialRelease",
  ":app:assembleOfficialPlaystore",
]
lint = [
  ":app:lintOfficialDebug",
]

[validation.final]
release-seal = [
  ":platform:testDebugUnitTest",
  ":platform:testNativeContracts",
  ":app:testOfficialDebugUnitTest",
  ":app:lintOfficialDebug",
  ":app:assembleOfficialDebug",
  ":app:assembleOfficialRelease",
  ":app:assembleOfficialPlaystore",
]
ash-static = ["scripts/validate-ashrexcue-release.sh", "--static-only"]
native = [":platform:testDebugUnitTest", ":platform:testNativeContracts"]

[validation]
android_safe = false
max_workers = 2
cpu_limit = 2
parallel = true
split_gradle = true
no_daemon = false
stop_daemon_after_phase = false
low_priority = false
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
gradle_packaging_metaspace_mb = 640
gradle_lint_metaspace_mb = 640
memory_guard_mb = 512
affected_module_lint = true


[validation.phase_profiles.preflight]
max_workers = 1
cpu_limit = 1
gradle_heap_mb = 768
gradle_metaspace_mb = 640
memory_guard_mb = 384
no_daemon = false
low_priority = false


[validation.phase_profiles.compile]
max_workers = 2
cpu_limit = 2
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
memory_guard_mb = 512
no_daemon = false
low_priority = false


[validation.phase_profiles.resources]
max_workers = 2
cpu_limit = 2
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
memory_guard_mb = 512
no_daemon = false
low_priority = false


[validation.phase_profiles.unit-test]
max_workers = 2
cpu_limit = 2
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
memory_guard_mb = 512
no_daemon = false
low_priority = false


[validation.phase_profiles.package]
max_workers = 2
cpu_limit = 2
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
memory_guard_mb = 640
no_daemon = false
low_priority = false


[validation.phase_profiles.lint]
max_workers = 1
cpu_limit = 2
gradle_heap_mb = 1280
gradle_metaspace_mb = 640
memory_guard_mb = 640
no_daemon = false
low_priority = false


[validation.phase_profiles.instrumentation]
max_workers = 1
cpu_limit = 2
gradle_heap_mb = 1024
gradle_metaspace_mb = 640
memory_guard_mb = 512
no_daemon = false
low_priority = false

